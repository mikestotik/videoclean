# Browser-facing SPA. Build-arg must be a URL the *browser* can reach (not Docker DNS).
ARG VITE_API_BASE_URL=http://localhost:7860

FROM oven/bun:1 AS build
WORKDIR /build
ARG VITE_API_BASE_URL
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
COPY webui/package.json webui/bun.lock ./
RUN bun install --frozen-lockfile
COPY webui/ ./
RUN bun run build

FROM nginx:1.27-alpine
COPY deploy/nginx-web.conf /etc/nginx/conf.d/default.conf
# vite outDir is ../server/static_dist relative to webui/
COPY --from=build /server/static_dist /usr/share/nginx/html
EXPOSE 80
