# Internal contour: auth off. Set to on (+ password) later for accounts/gateway.
VIDEOCLEAN_AUTH=off
VIDEOCLEAN_UI_USER=admin
VIDEOCLEAN_UI_PASSWORD=change-me

VIDEOCLEAN_PORT=7860
VIDEOCLEAN_WEB_PORT=8080
# Browser-reachable API URL baked into the web image (docker compose build).
VITE_API_BASE_URL=http://localhost:7860
# Comma list or * (split web→api).
VIDEOCLEAN_CORS=*

# локальный LLM (ollama). Удалённые модели не используются.
VIDEOCLEAN_LLM_MODEL=
